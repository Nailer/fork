      "light": "#FBFAF7",
      "dark": "#08090D"
    }
  },
  "fonts": {
    "heading": {
      "family": "Fraunces",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/logo/icon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/introduction"
  },
  "icons": {
    "library": "lucide"
  },
