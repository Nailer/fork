{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fork",
  "description": "Fork is an AI decision explorer for iOS, Android and web. Describe a hard choice and Fork maps it into 2–4 materially different paths you can explore, compare and choose between. Built with Expo, Supabase, Claude/Gemini and RevenueCat.",
