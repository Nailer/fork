# Copy to .env and fill in. Everything here is PUBLIC and ends up inside the app
# bundle — never put secret keys in an EXPO_PUBLIC_* variable.

# Fork AI proxy (Supabase Edge Function `analyze-decision`)
EXPO_PUBLIC_FORK_API_URL=https://<your-project-ref>.supabase.co/functions/v1/analyze-decision
# Supabase anon (public) key — required because the function verifies JWTs
EXPO_PUBLIC_FORK_API_KEY=<supabase-anon-key>

# RevenueCat public SDK keys (Project settings → API keys)
# Test Store key: works on web, Expo Go and dev builds; purchases are simulated
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_<...>
# Store keys for production builds (optional until you publish)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_<...>
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_<...>
# Entitlement identifier configured in RevenueCat
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=fork_pro

# Server-side secrets are NOT set here. Set them on the edge function instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Optional: FORK_MODEL (default claude-opus-5), FORK_RATE_LIMIT_PER_10_MIN (default 12)
